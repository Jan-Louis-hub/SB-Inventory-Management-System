{
  "name": "sb-inventory-management-system",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd server && python -m flask --app main run --debug --port 8000",
    "dev:frontend": "npm --prefix client run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
